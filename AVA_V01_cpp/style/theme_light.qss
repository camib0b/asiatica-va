/* ==========================================================================
   shadcn/ui-inspired light theme
   Design tokens  (zinc palette):
     --background:         #FFFFFF
     --foreground:         #09090b   (zinc-950)
     --primary:            #18181b   (zinc-900)
     --primary-foreground: #fafafa   (zinc-50)
     --secondary:          #f4f4f5   (zinc-100)
     --secondary-fg:       #18181b
     --muted:              #f4f4f5   (zinc-100)
     --muted-foreground:   #71717a   (zinc-500)
     --accent:             #f4f4f5
     --accent-foreground:  #18181b
     --destructive:        #ef4444
     --border:             #e4e4e7   (zinc-200)
     --input:              #e4e4e7
     --ring:               #18181b
     --radius:             6px       (rounded-md)
   ========================================================================== */

/* =========================
   Base
========================= */

QWidget#AppRoot {
  background: #FFFFFF;
  color: #09090b;
  font-size: 14px;
}

/* =========================
   Typography
========================= */

QLabel[role="muted"]   { color: #71717a; font-size: 13px; }
QLabel[role="faint"]   { color: #a1a1aa; font-size: 13px; }
QLabel[role="accent"]  { color: #B08A2E; }

QLabel[role="h1"] {
  font-size: 28px;
  font-weight: 700;
  color: #09090b;
  letter-spacing: -1px;
}

QLabel[role="h2"] {
  font-size: 22px;
  font-weight: 600;
  color: #09090b;
  letter-spacing: -0.5px;
}

QLabel[role="h3"] {
  font-size: 16px;
  font-weight: 600;
  color: #09090b;
}

/* =========================
   Separator
========================= */

QFrame[role="separator"] {
  background: #e4e4e7;
  min-height: 1px;
  max-height: 1px;
}

/* =========================
   Buttons – base + sizes
========================= */

QPushButton {
  background: #FFFFFF;
  border: 1px solid #e4e4e7;
  border-radius: 6px;
  padding: 8px 16px;
  font-size: 14px;
  font-weight: 500;
  color: #09090b;
  min-height: 36px;
}

QPushButton:hover {
  background: #f4f4f5;
  border-color: #d4d4d8;
}

QPushButton:pressed {
  background: #e4e4e7;
}

QPushButton:disabled {
  color: rgba(9, 9, 11, 0.40);
  background: #fafafa;
  border-color: #e4e4e7;
}

/* Focus ring */
QPushButton:focus {
  border: 2px solid #18181b;
  padding: 7px 15px;
}

/* Sizes */
QPushButton[size="xs"] {
  padding: 4px 8px;
  font-size: 12px;
  min-height: 28px;
  border-radius: 6px;
}

QPushButton[size="sm"] {
  padding: 6px 12px;
  font-size: 13px;
  min-height: 32px;
  border-radius: 6px;
}

QPushButton[size="md"] {
  padding: 8px 16px;
  min-height: 36px;
}

QPushButton[size="lg"] {
  padding: 10px 24px;
  border-radius: 6px;
  font-size: 14px;
  min-height: 40px;
}

/* =========================
   Button variants
========================= */

/* Primary – dark bg, white text (shadcn default/primary) */
QPushButton[variant="primary"] {
  background: #18181b;
  border: 1px solid #18181b;
  color: #fafafa;
  font-weight: 600;
}
QPushButton[variant="primary"]:hover {
  background: #27272a;
  border-color: #27272a;
}
QPushButton[variant="primary"]:pressed {
  background: #09090b;
}
QPushButton[variant="primary"]:focus {
  border: 2px solid #18181b;
  outline: 2px solid rgba(24, 24, 27, 0.20);
  padding: 7px 15px;
}

/* Black – alias for primary */
QPushButton[variant="black"] {
  background: #18181b;
  color: #fafafa;
  border: 1px solid #18181b;
  font-weight: 600;
}
QPushButton[variant="black"]:hover { background: #27272a; border-color: #27272a; }
QPushButton[variant="black"]:pressed { background: #09090b; }

/* Secondary */
QPushButton[variant="secondary"] {
  background: #f4f4f5;
  border: 1px solid #e4e4e7;
  color: #18181b;
  font-weight: 500;
}
QPushButton[variant="secondary"]:hover {
  background: #e4e4e7;
  border-color: #d4d4d8;
}
QPushButton[variant="secondary"]:pressed {
  background: #d4d4d8;
}

/* Outline */
QPushButton[variant="outline"] {
  background: transparent;
  border: 1px solid #e4e4e7;
  color: #09090b;
}
QPushButton[variant="outline"]:hover {
  background: #f4f4f5;
  border-color: #d4d4d8;
}
QPushButton[variant="outline"]:pressed {
  background: #e4e4e7;
}

/* Ghost */
QPushButton[variant="ghost"] {
  background: transparent;
  border: 1px solid transparent;
  color: #09090b;
}
QPushButton[variant="ghost"]:hover {
  background: #f4f4f5;
}
QPushButton[variant="ghost"]:pressed {
  background: #e4e4e7;
}

/* Destructive */
QPushButton[variant="destructive"] {
  background: #ef4444;
  border: 1px solid #ef4444;
  color: #fafafa;
  font-weight: 600;
}
QPushButton[variant="destructive"]:hover {
  background: #dc2626;
  border-color: #dc2626;
}
QPushButton[variant="destructive"]:pressed {
  background: #b91c1c;
}

/* Gold accent (brand) */
QPushButton[variant="gold"] {
  background: rgba(176, 138, 46, 0.12);
  border: 1px solid rgba(176, 138, 46, 0.35);
  color: #5C4511;
  font-weight: 600;
}
QPushButton[variant="gold"]:hover { background: rgba(176, 138, 46, 0.20); }
QPushButton[variant="gold"]:pressed { background: rgba(176, 138, 46, 0.28); }

QPushButton[variant="secondary"]:focus,
QPushButton[variant="outline"]:focus,
QPushButton[variant="ghost"]:focus,
QPushButton[variant="destructive"]:focus,
QPushButton[variant="gold"]:focus,
QPushButton[variant="black"]:focus {
  border: 2px solid #18181b;
}

/* Welcome/Setup CTA */
QPushButton[variant="welcomeImport"] {
  background: #18181b;
  border: 1px solid #18181b;
  color: #fafafa;
  font-weight: 600;
}
QPushButton[variant="welcomeImport"]:hover {
  background: #27272a;
  border-color: #27272a;
}
QPushButton[variant="welcomeImport"]:pressed {
  background: #09090b;
}
QPushButton[variant="welcomeImport"]:focus {
  border: 2px solid #18181b;
  padding: 9px 23px;
}
QPushButton[variant="welcomeImport"]:disabled {
  color: rgba(9, 9, 11, 0.40);
  background: #fafafa;
  border: 1px solid #e4e4e7;
}

/* Soft ring outside the welcome import button. 14px = the 6px button radius
   plus the 8px outset reserved around the button in Motion.cpp. */
QWidget[role="ambientRing"] {
  background: transparent;
  border: 2px solid #18181b;
  border-radius: 14px;
  padding: 0px;
  min-width: 0px;
  min-height: 0px;
}

/* Flash state (momentary feedback) */
QPushButton[flash="true"] {
  border-color: #18181b;
  background: #f4f4f5;
}

/* Active main event while follow-ups visible */
QPushButton[activeMain="true"] {
  border-color: #18181b;
  background: #f4f4f5;
  font-weight: 600;
}

/* Active speed button */
QPushButton[speedActive="true"] {
  background: #f4f4f5;
}
QPushButton[variant="ghost"][speedActive="true"] {
  background: #f4f4f5;
}

/* =========================
   Game Controls
========================= */

/* Rest stroke is zinc-400, not --border (zinc-200): the panel behind these
   keys is the same white as the fill, and zinc-200 disappears into it.
   Hover and press step to zinc-500. No drop shadow — the keys sit 4px apart. */
QPushButton[variant="gameControl"] {
  background: #FFFFFF;
  border: 1px solid #a1a1aa;
  border-radius: 6px;
  font-weight: 500;
}
QPushButton[variant="gameControl"]:hover {
  background: #f4f4f5;
  border-color: #71717a;
}
QPushButton[variant="gameControl"]:pressed {
  background: #e4e4e7;
  border-color: #71717a;
}
QPushButton[variant="gameControl"]:focus {
  border: 2px solid #18181b;
  padding: 7px 15px;
}

/* teamSelected fallback; GameControls applies team jersey color via widget stylesheet when available */
QPushButton[variant="gameControl"][teamSelected="true"] {
  border: 2px solid #18181b;
  background: #f4f4f5;
  font-weight: 700;
  color: #09090b;
  padding: 7px 15px;
}
QPushButton[variant="gameControl"][teamSelected="true"]:hover {
  background: #e4e4e7;
  border: 2px solid #18181b;
}
QPushButton[variant="gameControl"][teamSelected="true"]:focus {
  border: 2px solid #18181b;
  background: #f4f4f5;
  padding: 7px 15px;
}

QPushButton[variant="gameControl"][activeMain="true"] {
  border: 2px solid #18181b;
  background: #f4f4f5;
  font-weight: 700;
  color: #09090b;
  padding: 7px 15px;
}
QPushButton[variant="gameControl"][activeMain="true"]:hover {
  background: #e4e4e7;
  border: 2px solid #18181b;
}
QPushButton[variant="gameControl"][activeMain="true"]:focus {
  border: 2px solid #18181b;
  background: #f4f4f5;
  padding: 7px 15px;
}

QPushButton[variant="gameControl"][flash="true"] {
  border: 1px solid #18181b;
  background: #f4f4f5;
}
QPushButton[variant="gameControl"][flash="true"]:focus {
  border: 2px solid #18181b;
  padding: 7px 15px;
}

/* Two-line game control labels */
QLabel[role="gameControlTitle"] {
  color: #09090b;
  font-weight: 600;
  font-size: 12px;
}
QLabel[role="gameControlTitle"][titleDensity="compact"] {
  font-size: 10px;
}
QPushButton[variant="gameControl"] QLabel[role="muted"] {
  color: #71717a;
  font-size: 11px;
  font-weight: 400;
}
QPushButton[variant="gameControl"][activeMain="true"] QLabel[role="gameControlTitle"] {
  color: #09090b;
  font-weight: 700;
}
QPushButton[variant="gameControl"][activeMain="true"] QLabel[role="muted"] {
  color: #52525b;
}

/* Follow-up buttons — zinc-950 fill so light labels stay readable */
QPushButton[variant="gameControlFollowUp"] {
  background: #09090b;
  border: 1px solid #09090b;
  border-radius: 6px;
  font-weight: 600;
  color: #fafafa;
}
QPushButton[variant="gameControlFollowUp"]:hover {
  background: #18181b;
  border-color: #18181b;
}
QPushButton[variant="gameControlFollowUp"]:pressed {
  background: #000000;
  border-color: #000000;
}
QPushButton[variant="gameControlFollowUp"]:focus {
  border: 2px solid #18181b;
  background: #09090b;
  padding: 7px 15px;
}
QPushButton[variant="gameControlFollowUp"][flash="true"] {
  border: 1px solid #18181b;
  background: #18181b;
  padding: 8px 16px;
}
QPushButton[variant="gameControlFollowUp"][flash="true"]:focus {
  border: 2px solid #18181b;
  background: #09090b;
  padding: 7px 15px;
}

QPushButton[variant="gameControlFollowUp"] QLabel[role="gameControlTitle"] {
  background: transparent;
  color: #fafafa;
  font-weight: 600;
  font-size: 12px;
}
QPushButton[variant="gameControl"] QLabel[role="gameControlTitle"][titleDensity="compact"],
QPushButton[variant="gameControlFollowUp"] QLabel[role="gameControlTitle"][titleDensity="compact"] {
  font-size: 10px;
}

QPushButton[variant="gameControlFollowUp"] QLabel[role="muted"] {
  background: transparent;
  color: #a1a1aa;
  font-size: 11px;
  font-weight: 400;
}

/* Disabled reads as disabled on every variant. welcomeImport keeps its own rule. */
QPushButton:disabled,
QPushButton[variant="primary"]:disabled,
QPushButton[variant="black"]:disabled,
QPushButton[variant="secondary"]:disabled,
QPushButton[variant="outline"]:disabled,
QPushButton[variant="ghost"]:disabled,
QPushButton[variant="destructive"]:disabled,
QPushButton[variant="gold"]:disabled,
QPushButton[variant="gameControl"]:disabled,
QPushButton[variant="gameControlFollowUp"]:disabled {
  color: #52525b;
  background: #f4f4f5;
  border: 1px solid #e4e4e7;
}
QPushButton[variant="gameControl"]:disabled QLabel,
QPushButton[variant="gameControlFollowUp"]:disabled QLabel {
  color: #52525b;
}

/* =========================
   Inputs
========================= */

QLineEdit, QTextEdit, QPlainTextEdit {
  background: #FFFFFF;
  border: 1px solid #e4e4e7;
  border-radius: 6px;
  padding: 5px 10px;
  font-size: 14px;
  color: #09090b;
  selection-background-color: rgba(24, 24, 27, 0.12);
  selection-color: #09090b;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
  border: 1px solid #18181b;
}

QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
  background: #fafafa;
  color: #a1a1aa;
}

QListWidget#MatchNoteMentionPopup {
  background: #FFFFFF;
  border: 1px solid #e4e4e7;
  border-radius: 6px;
  padding: 4px;
  outline: none;
}

QListWidget#MatchNoteMentionPopup::item {
  padding: 6px 8px;
  border-radius: 4px;
  color: #09090b;
}

QListWidget#MatchNoteMentionPopup::item:selected {
  background: #18181b;
  color: #fafafa;
}

/* Concatenation order: one vertical sequence that feeds a single output. */
QDialog[role="fileOrder"] {
  min-width: 480px;
  min-height: 560px;
}

QScrollArea[role="clipSequence"] {
  background: transparent;
  border: none;
  min-height: 160px;
}

QScrollArea[role="clipSequence"] QWidget {
  background: transparent;
}

QFrame[role="clipRow"] {
  background: transparent;
  border: 1px solid transparent;
  border-radius: 8px;
}

QFrame[role="clipRow"]:hover {
  background: #fafafa;
}

QFrame[role="clipRow"][selected="true"] {
  background: #f4f4f5;
  border: 1px solid #18181b;
}

QFrame[role="clipRow"][selected="true"]:hover {
  background: #f4f4f5;
  border: 1px solid #18181b;
}

QDialog[role="fileOrder"] QLabel[role="clipIndex"] {
  background: #ffffff;
  color: #09090b;
  border: 1px solid #d4d4d8;
  border-radius: 14px;
  font-weight: 600;
  font-size: 13px;
  padding: 2px;
  min-width: 1.5em;
  min-height: 1.5em;
}

QFrame[role="clipConnector"] {
  background: #d4d4d8;
  border: none;
  min-width: 2px;
  max-width: 2px;
  border-radius: 1px;
}

QDialog[role="fileOrder"] QLabel[role="clipTitle"] {
  color: #09090b;
  font-size: 15px;
  font-weight: 600;
}

QDialog[role="fileOrder"] QLabel[role="clipTime"] {
  color: #18181b;
  font-size: 13px;
  font-weight: 500;
}

QDialog[role="fileOrder"] QLabel[role="clipFile"] {
  color: #71717a;
  font-size: 12px;
}

QDialog[role="fileOrder"] QPushButton[role="clipMove"],
QDialog[role="fileOrder"] QPushButton[role="clipMove"]:focus {
  min-width: 32px;
  min-height: 22px;
  padding: 0 6px;
  font-size: 13px;
}

QLabel[role="clipFlow"] {
  color: #a1a1aa;
  font-size: 16px;
  padding: 0;
  min-height: 0;
}

QFrame[role="clipOutput"] {
  background: #f4f4f5;
  border: 1px solid #e4e4e7;
  border-radius: 8px;
}

QDialog[role="fileOrder"] QLabel[role="clipOutputTitle"] {
  color: #09090b;
  font-size: 15px;
  font-weight: 600;
}

QFrame[role="clipDrop"] {
  background: #18181b;
  border: none;
  min-height: 2px;
  max-height: 2px;
}

QWidget[role="devFixture"] {
  background: #f4f4f5;
  border-radius: 8px;
}

QWidget[role="devFixture"] QPushButton {
  background: transparent;
  border: none;
  color: #71717a;
  font-size: 12px;
  font-weight: 500;
  min-height: 24px;
  padding: 2px 10px;
}

QWidget[role="devFixture"] QPushButton:hover {
  color: #09090b;
}

QWidget[role="devFixture"] QPushButton:checked {
  background: #ffffff;
  color: #09090b;
  border-radius: 6px;
}

QWidget[role="devFixture"] QPushButton:focus {
  padding: 1px 9px;
  border: 2px solid #18181b;
}

/* =========================
   ComboBox / Select
========================= */

QComboBox {
  background: #FFFFFF;
  border: 1px solid #e4e4e7;
  border-radius: 6px;
  padding: 4px 10px;
  font-size: 14px;
  color: #09090b;
  min-height: 28px;
}

QComboBox:hover {
  border-color: #d4d4d8;
}

QComboBox:focus,
QComboBox:on {
  border: 1px solid #18181b;
}

QComboBox:disabled {
  color: #52525b;
  background: #f4f4f5;
  border-color: #e4e4e7;
}

QComboBox::drop-down {
  border: none;
  width: 24px;
  subcontrol-position: center right;
  subcontrol-origin: padding;
  padding-right: 8px;
}

QComboBox::down-arrow {
  width: 10px;
  height: 10px;
}

/* Presentation filters. The shared combo rule reserves a wide arrow lane on
   top of the padding, so a short value such as "Ambos" was clipped while the
   box still showed empty white space. These two boxes keep a 16px arrow. */
QComboBox#PresentationEventFilter,
QComboBox#PresentationTeamFilter {
  padding: 4px 2px 4px 8px;
  min-width: 0px;
}
QComboBox#PresentationEventFilter::drop-down,
QComboBox#PresentationTeamFilter::drop-down {
  width: 16px;
  padding: 0px;
  border: none;
  subcontrol-origin: border;
  subcontrol-position: center right;
}

QComboBox QAbstractItemView {
  background: #FFFFFF;
  border: 1px solid #e4e4e7;
  border-radius: 6px;
  padding: 4px;
  selection-background-color: #f4f4f5;
  selection-color: #09090b;
  outline: none;
}

QComboBox QAbstractItemView::item {
  padding: 6px 8px;
  border-radius: 4px;
  min-height: 32px;
}

QComboBox QAbstractItemView::item:selected {
  background: #f4f4f5;
  color: #09090b;
}

QComboBox[variant="compact"] {
  min-height: 28px;
  padding: 2px 8px;
  font-size: 13px;
}

QComboBox[variant="compact"]::drop-down {
  width: 20px;
  padding-right: 4px;
}

QComboBox[variant="abbrev"] {
  min-height: 28px;
  min-width: 56px;
  padding: 2px 6px;
  font-size: 13px;
}

QComboBox[variant="abbrev"]::drop-down {
  width: 18px;
  padding-right: 4px;
}

QDialog#XmlEventMappingDialog QTableWidget::item {
  padding: 2px 6px;
}

QDialog#XmlEventMappingDialog QTableWidget::item:selected {
  background: #e4e4e7;
  color: #09090b;
}

QDialog#XmlEventMappingDialog QHeaderView::section {
  padding: 6px 6px;
}

/* =========================
   SpinBox / DoubleSpinBox
========================= */

QSpinBox, QDoubleSpinBox {
  background: #FFFFFF;
  border: 1px solid #e4e4e7;
  border-radius: 6px;
  padding: 4px 10px;
  font-size: 14px;
  color: #09090b;
  min-height: 28px;
}

QSpinBox:focus, QDoubleSpinBox:focus {
  border: 1px solid #18181b;
}

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
  background: transparent;
  border: none;
  width: 20px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
  background: #f4f4f5;
}

/* =========================
   CheckBox
========================= */

QCheckBox {
  spacing: 8px;
  font-size: 14px;
  color: #09090b;
}

QCheckBox::indicator {
  width: 16px;
  height: 16px;
  border: 1px solid #18181b;
  border-radius: 4px;
  background: #FFFFFF;
}

QCheckBox::indicator:hover {
  border-color: #09090b;
  background: #fafafa;
}

QCheckBox::indicator:checked {
  background: #18181b;
  border-color: #18181b;
}

QCheckBox::indicator:disabled {
  background: #f4f4f5;
  border-color: #d4d4d8;
}

/* =========================
   ToolButton
========================= */

QToolButton {
  border-radius: 6px;
  padding: 6px 12px;
  border: 1px solid #e4e4e7;
  background: #FFFFFF;
  min-height: 32px;
  font-size: 14px;
  font-weight: 500;
  color: #09090b;
}

QToolButton:hover {
  background: #f4f4f5;
  border-color: #d4d4d8;
}

QToolButton:pressed {
  background: #e4e4e7;
}

QToolButton:disabled,
QToolButton[variant="ghost"]:disabled {
  color: #52525b;
  background: #f4f4f5;
  border: 1px solid #e4e4e7;
}

QToolButton[size="sm"] {
  padding: 4px 10px;
  font-size: 13px;
  border-radius: 6px;
  min-height: 28px;
}

QToolButton[variant="ghost"] {
  background: transparent;
  border: 1px solid transparent;
}
QToolButton[variant="ghost"]:hover {
  background: #f4f4f5;
}
QToolButton[variant="ghost"]:pressed {
  background: #e4e4e7;
}

QToolButton:focus,
QToolButton[variant="ghost"]:focus {
  border: 2px solid #18181b;
}
QToolButton:focus {
  padding: 5px 11px;
}
QToolButton[size="sm"]:focus {
  padding: 3px 9px;
}

QToolButton#VideoMuteButton,
QToolButton#VideoMenuButton {
  padding: 4px;
  min-width: 36px;
  min-height: 32px;
}
QToolButton#VideoMuteButton:focus,
QToolButton#VideoMenuButton:focus {
  padding: 3px;
}

QToolButton#VideoMuteButton[flash="true"] {
  border: 1px solid #18181b;
  background: #f4f4f5;
}

/* Stats team filter – checked state (white chip, dark text for readability) */
QWidget#StatsTeamFilterRow QToolButton[variant="ghost"]:checked {
  background: #FFFFFF;
  border: 1px solid #e4e4e7;
  color: #09090b;
  font-weight: 600;
}
QWidget#StatsTeamFilterRow QToolButton[variant="ghost"]:checked:hover {
  background: #fafafa;
  border-color: #d4d4d8;
}
QWidget#StatsTeamFilterRow QToolButton[variant="ghost"]:focus {
  border: 2px solid #18181b;
}

/* Mode toggle group */
QWidget#WorkModeToggleGroup {
  background: #f4f4f5;
  border: 1px solid #e4e4e7;
  border-radius: 6px;
}

QToolButton#WorkModeTaggingButton,
QToolButton#WorkModeAnalyzingButton,
QToolButton#WorkModePresentingButton {
  min-width: 100px;
  background: transparent;
  border: 1px solid transparent;
  font-weight: 500;
}

QToolButton#WorkModeTaggingButton:checked,
QToolButton#WorkModeAnalyzingButton:checked,
QToolButton#WorkModePresentingButton:checked {
  background: transparent;
  border: 1px solid transparent;
  font-weight: 600;
}
QToolButton#WorkModeTaggingButton:checked:hover,
QToolButton#WorkModeAnalyzingButton:checked:hover,
QToolButton#WorkModePresentingButton:checked:hover,
QToolButton#WorkModeTaggingButton:!checked:hover,
QToolButton#WorkModeAnalyzingButton:!checked:hover,
QToolButton#WorkModePresentingButton:!checked:hover {
  background: transparent;
  border: 1px solid transparent;
}

QToolButton#WorkModeTaggingButton:focus,
QToolButton#WorkModeAnalyzingButton:focus,
QToolButton#WorkModePresentingButton:focus {
  border: 2px solid #18181b;
  background: transparent;
  padding: 3px 9px;
}

/* =========================
   Presentation mode
========================= */

QSplitter#PresentationSplitter,
QSplitter#WorkLeftSplitter,
QSplitter#WorkTagsNotesSplitter {
  background-color: #FFFFFF;
}

QWidget#PresentationStageColumn {
  background-color: #FFFFFF;
}

QWidget#PresentationBanner {
  background-color: #18181b;
  border: 1px solid #3f3f46;
  border-radius: 6px;
}

QLabel#PresentationEventLabel {
  color: #ffffff;
  font-size: 16px;
  font-weight: 600;
}

QLabel#PresentationContextLabel {
  color: #e4e4e7;
  font-size: 12px;
  font-weight: 500;
}

QLabel#PresentationNoteLabel {
  color: #fde68a;
  font-size: 13px;
  font-weight: 500;
}

QWidget#PresentationPanel QPushButton[variant="primary"] {
  background: #000000;
  border: 1px solid #000000;
  color: #ffffff;
  font-weight: 600;
}

QWidget#PresentationPanel QPushButton[variant="primary"]:hover {
  background: #09090b;
  border-color: #09090b;
  color: #ffffff;
}

QWidget#PresentationPanel QPushButton[variant="primary"]:pressed {
  background: #000000;
  border-color: #000000;
  color: #ffffff;
}

QWidget#PresentationPanel QPushButton[variant="primary"]:focus {
  background: #000000;
  border: 2px solid #ffffff;
  color: #ffffff;
}

QWidget#PresentationPanel QPushButton[variant="primary"]:disabled {
  color: #52525b;
  background: #f4f4f5;
  border: 1px solid #e4e4e7;
}

/* The apply-to-selected label wraps inside the button. The button's own
   padding is cleared so a focus ring cannot shrink the text box and clip
   the ends. The label padding is the text inset; C++ reads it back. */
QWidget#PresentationPanel QPushButton#ApplyToAllButton,
QWidget#PresentationPanel QPushButton#ApplyToAllButton:hover,
QWidget#PresentationPanel QPushButton#ApplyToAllButton:pressed,
QWidget#PresentationPanel QPushButton#ApplyToAllButton:focus,
QWidget#PresentationPanel QPushButton#ApplyToAllButton:disabled {
  padding: 0px;
  min-height: 0px;
}

QWidget#PresentationPanel QPushButton#ApplyToAllButton QLabel#ApplyToAllButtonLabel {
  background: transparent;
  color: #09090b;
  font-size: 14px;
  font-weight: 500;
  padding: 8px 12px;
}

QWidget#PresentationPanel QPushButton#ApplyToAllButton:disabled QLabel#ApplyToAllButtonLabel {
  color: rgba(9, 9, 11, 0.40);
}

QDoubleSpinBox#LeadSpinBox::up-button,
QDoubleSpinBox#LeadSpinBox::down-button {
  background-color: rgba(72, 199, 142, 0.18);
}

QDoubleSpinBox#LeadSpinBox::up-button:hover,
QDoubleSpinBox#LeadSpinBox::down-button:hover {
  background-color: rgba(72, 199, 142, 0.40);
}

QDoubleSpinBox#LagSpinBox::up-button,
QDoubleSpinBox#LagSpinBox::down-button {
  background-color: rgba(248, 113, 113, 0.18);
}

QDoubleSpinBox#LagSpinBox::up-button:hover,
QDoubleSpinBox#LagSpinBox::down-button:hover {
  background-color: rgba(248, 113, 113, 0.40);
}

/* The selection summary is a control only when the checked clips are not
   already one event on the current list. The underline is the affordance;
   the color stays in the muted family. */
QWidget#PresentationPanel QLabel#PresentationSelectionSummary[interactive="true"] {
  color: #3f3f46;
  text-decoration: underline;
}

QWidget#PresentationPanel QLabel#PresentationSelectionSummary[interactive="true"]:hover {
  color: #18181b;
}

QFrame#PresentationSelectionPopup {
  background: #ffffff;
  border: 1px solid #e4e4e7;
  border-radius: 6px;
  color: #09090b;
  font-size: 13px;
}

QFrame#PresentationSelectionPopup QScrollArea {
  background: transparent;
  border: none;
}

QFrame#PresentationSelectionEventRow {
  background: transparent;
  border: none;
  border-radius: 4px;
}

QFrame#PresentationSelectionEventRow:hover {
  background: #f4f4f5;
}

QWidget#PresentationSelectionEventName {
  color: #09090b;
  background: transparent;
}

QLabel#PresentationSelectionEventDash {
  color: #a1a1aa;
  background: transparent;
  padding: 0px;
}

QWidget#PresentationSelectionEventCount {
  color: #52525b;
  background: transparent;
}

QWidget#ExportJobsBar {
  background-color: #fafafa;
  border-top: 1px solid #e4e4e7;
}

QWidget#ExportJobRow {
  border-radius: 6px;
}

QWidget#ExportJobRow[jobState="failed"] {
  background-color: #fef2f2;
}

QLabel[role="exportError"] {
  color: #b91c1c;
  font-size: 13px;
  font-weight: 600;
}

QWidget#ExportJobsBar QPushButton[size="sm"] {
  padding: 4px 12px;
  min-height: 28px;
}

QWidget#ExportJobsBar QPushButton[size="sm"]:focus {
  padding: 3px 11px;
}

QWidget#ExportJobsBar QProgressBar {
  min-height: 14px;
  max-height: 14px;
  font-size: 11px;
  color: #09090b;
}

/* =========================
   Menu / Dropdown
========================= */

QMenu {
  background: #FFFFFF;
  border: 1px solid #e4e4e7;
  border-radius: 6px;
  padding: 4px;
}

QMenu::item {
  padding: 6px 8px;
  border-radius: 4px;
  font-size: 14px;
  color: #09090b;
}

QMenu::item:selected {
  background: #f4f4f5;
}

QMenu::item:disabled {
  color: #a1a1aa;
}

QMenu::separator {
  height: 1px;
  background: #e4e4e7;
  margin: 4px 4px;
}

/* =========================
   Work lists
   Tagging event log, analysis stats tree, and presentation clip list.
   Tag the view with Style::configureWorkDataView (role "workList").
   QTableWidget stays in this block for dialogs that are not work lists.
========================= */

QTableWidget,
QAbstractItemView[role="workList"] {
  background: #FFFFFF;
  border: 1px solid #e4e4e7;
  border-radius: 6px;
  gridline-color: transparent;
  font-size: 13px;
  color: #09090b;
  selection-background-color: #f4f4f5;
  selection-color: #09090b;
  alternate-background-color: #fafafa;
  outline: none;
}

QTableWidget::item,
QAbstractItemView[role="workList"]::item {
  border-bottom: 1px solid #f4f4f5;
  padding: 4px 8px;
  min-height: 28px;
}

QTableWidget::item:selected,
QAbstractItemView[role="workList"]::item:selected {
  background: #f4f4f5;
  color: #09090b;
}

QTableWidget::item:hover,
QAbstractItemView[role="workList"]::item:hover {
  background: rgba(244, 244, 245, 0.5);
}

/* Presentation clip list. The shared work-list selection (#f4f4f5) is the same
   family as the row hairline, the alternate row, and hover, so the selected
   clip disappears. This table uses the playhead wash (#93C5FD, ThemeColors::
   playheadHighlight) for the selected row. Hover stays the zinc wash and does
   not replace a selected row. Focus is the ring (#18181b), not a second fill.
   The delegate paints a ring-colored edge on the current/selected row because
   a left edge cannot be expressed on one cell of a row from QSS alone. */
QTableView#PresentationInstancesTable {
  selection-background-color: #93C5FD;
  selection-color: #09090b;
}

QTableView#PresentationInstancesTable::item:hover {
  background: rgba(244, 244, 245, 0.5);
  color: #09090b;
}

QTableView#PresentationInstancesTable::item:selected,
QTableView#PresentationInstancesTable::item:selected:hover {
  background: #93C5FD;
  color: #09090b;
}

QTableView#PresentationInstancesTable::item:focus,
QTableView#PresentationInstancesTable::item:selected:focus {
  color: #09090b;
}

/* The focus ring and the selected-row edge are drawn by the clip delegate.
   A QSS border would change item padding and shift the timestamp. */

QTableView[role="workList"]::indicator {
  width: 16px;
  height: 16px;
  border: 1px solid #18181b;
  border-radius: 4px;
  background: #FFFFFF;
}

QTableView[role="workList"]::indicator:hover {
  border-color: #09090b;
  background: #fafafa;
}

QTableView[role="workList"]::indicator:checked {
  background: #18181b;
  border-color: #18181b;
}

QTableView[role="workList"]::indicator:disabled {
  background: #f4f4f5;
  border-color: #d4d4d8;
}

QTreeWidget[role="workList"]::branch {
  background: transparent;
}

QHeaderView {
  background: transparent;
}

QHeaderView::section {
  background: #fafafa;
  border: none;
  border-bottom: 1px solid #e4e4e7;
  padding: 8px 8px;
  font-weight: 500;
  font-size: 13px;
  color: #71717a;
}

QHeaderView::section:first {
  border-top-left-radius: 6px;
}

QHeaderView::section:last {
  border-top-right-radius: 6px;
}

/* =========================
   Timeline slider
========================= */

QWidget#VideoStage,
QGraphicsView#VideoSurface {
  background-color: #000000;
}

QWidget#TelestrationToolBar {
  background: rgba(255, 255, 255, 0.94);
  border: 1px solid #e4e4e7;
  border-radius: 8px;
}

QWidget#TelestrationToolBar QPushButton {
  min-width: 28px;
  max-width: 28px;
  min-height: 28px;
  max-height: 28px;
  padding: 2px;
}

QWidget#TelestrationToolBar QPushButton#TelestrationUndoButton {
  min-width: 0;
  max-width: 88px;
  padding: 2px 8px;
}

QWidget#TelestrationToolBar QPushButton:checked {
  background: #18181b;
  color: #fafafa;
  border-color: #18181b;
}

QWidget#TelestrationToolBar QPushButton[role="swatch"]:checked {
  background: #ffffff;
  color: #18181b;
  border-color: #18181b;
}

QWidget#VideoTimelineBar {
  background-color: #FFFFFF;
}

QSlider#TimelineSlider::groove:horizontal {
  height: 6px;
  border-radius: 3px;
  background: #e4e4e7;
}

QSlider#TimelineSlider::sub-page:horizontal {
  height: 6px;
  border-radius: 3px;
  background: #18181b;
}

QSlider#TimelineSlider::add-page:horizontal {
  height: 6px;
  border-radius: 3px;
  background: #e4e4e7;
}

QSlider#TimelineSlider::handle:horizontal {
  width: 14px;
  height: 14px;
  margin: -4px 0;
  border-radius: 7px;
  background: #FFFFFF;
  border: 2px solid #18181b;
}

QSlider#TimelineSlider::handle:horizontal:hover {
  background: #f4f4f5;
  border-color: #09090b;
}

/* =========================
   Video controls bar (compact overlay chip)
========================= */

QWidget#VideoControlsBar {
  background: transparent;
  border: none;
}

QWidget#VideoControlsBar QPushButton {
  padding: 0 6px;
  font-size: 11px;
  min-height: 20px;
  max-height: 20px;
  border-radius: 6px;
  border: none;
  color: #fafafa;
  background-color: transparent;
  background: transparent;
  font-weight: 500;
}

QWidget#VideoControlsBar QPushButton:hover {
  background: rgba(255, 255, 255, 0.12);
}

QWidget#VideoControlsBar QPushButton:pressed {
  background: rgba(255, 255, 255, 0.20);
}

QWidget#VideoControlsBar QPushButton:disabled {
  color: rgba(250, 250, 250, 0.55);
  background: transparent;
}

QWidget#VideoControlsBar QPushButton:focus {
  border: none;
  outline: none;
  padding: 0 6px;
}

QWidget#VideoControlsBar QPushButton#PlayPauseButton {
  min-width: 20px;
  max-width: 20px;
  min-height: 20px;
  max-height: 20px;
  padding: 0;
}

QWidget#VideoControlsBar QPushButton#PlayPauseButton:focus {
  padding: 0;
}

QWidget#VideoControlsBar QPushButton[variant="primary"],
QWidget#VideoControlsBar QPushButton[variant="secondary"],
QWidget#VideoControlsBar QPushButton[variant="outline"],
QWidget#VideoControlsBar QPushButton[variant="ghost"] {
  border: none;
  color: #fafafa;
  background: transparent;
  font-weight: 500;
}

QWidget#VideoControlsBar QPushButton[variant="primary"]:hover,
QWidget#VideoControlsBar QPushButton[variant="secondary"]:hover,
QWidget#VideoControlsBar QPushButton[variant="outline"]:hover,
QWidget#VideoControlsBar QPushButton[variant="ghost"]:hover {
  background: rgba(255, 255, 255, 0.12);
}

QWidget#VideoControlsBar QPushButton[variant="primary"]:pressed,
QWidget#VideoControlsBar QPushButton[variant="secondary"]:pressed,
QWidget#VideoControlsBar QPushButton[variant="outline"]:pressed,
QWidget#VideoControlsBar QPushButton[variant="ghost"]:pressed {
  background: rgba(255, 255, 255, 0.20);
}

QWidget#VideoControlsBar QPushButton[variant="primary"]:disabled,
QWidget#VideoControlsBar QPushButton[variant="secondary"]:disabled,
QWidget#VideoControlsBar QPushButton[variant="outline"]:disabled,
QWidget#VideoControlsBar QPushButton[variant="ghost"]:disabled {
  color: rgba(250, 250, 250, 0.55);
  background: transparent;
}

QWidget#VideoControlsBar QPushButton[flash="true"] {
  border: none;
  background: rgba(255, 255, 255, 0.28);
  color: #fafafa;
}

QWidget#VideoControlsBar QPushButton[speedActive="true"],
QWidget#VideoControlsBar QPushButton[variant="ghost"][speedActive="true"] {
  border: none;
  background: rgba(255, 255, 255, 0.24);
  color: #fafafa;
}

QWidget#VideoControlsBar QPushButton:checked {
  background: rgba(255, 255, 255, 0.22);
  color: #fafafa;
}

QWidget#VideoControlsBar QWidget#PlaybackSpeedometer {
  min-height: 20px;
  border: none;
  background: transparent;
  font-size: 12px;
}

QWidget#VideoControlsBar QLabel {
  font-size: 12px;
  color: #d1d5dc;
}

QWidget#VideoControlsBar QLabel[role="muted"] {
  color: #d4d4d8;
}

/* Tag confirmation drawn over the video. The pill itself is painted by
   TagToastOverlay; this only styles the chain text. */
QWidget#TagToastOverlay {
  background: transparent;
  border: none;
}
QWidget#TagToastOverlay QLabel[role="tagToastChain"] {
  color: #fafafa;
  font-size: 13px;
  font-weight: 600;
  background: transparent;
  padding: 0px;
}

/* Focus uses a 2px border. Shrink padding by 1px so the label box stays put.
   Placed after variant :focus rules so a size token wins over a variant's
   default padding, and before the tagging-column overrides. */
QPushButton[size="xs"]:focus {
  padding: 3px 7px;
}
QPushButton[size="sm"]:focus {
  padding: 5px 11px;
}
QPushButton[size="md"]:focus {
  padding: 7px 15px;
}
QPushButton[size="lg"]:focus {
  padding: 9px 23px;
}

/* Compact game controls in the tagging column (left of the video while tagging).
   Size, focus, and state rules elsewhere set 15–24px of horizontal padding;
   these selectors win so the tagging side panel is not forced wide. */
QWidget#TaggingRightCol QPushButton[variant="gameControl"],
QWidget#TaggingRightCol QPushButton[variant="gameControl"][size="md"],
QWidget#TaggingRightCol QPushButton[variant="gameControl"][size="lg"],
QWidget#TaggingRightCol QPushButton[variant="gameControl"]:focus,
QWidget#TaggingRightCol QPushButton[variant="gameControl"][size="md"]:focus,
QWidget#TaggingRightCol QPushButton[variant="gameControl"][size="lg"]:focus,
QWidget#TaggingRightCol QPushButton[variant="gameControl"][activeMain="true"],
QWidget#TaggingRightCol QPushButton[variant="gameControl"][activeMain="true"]:focus,
QWidget#TaggingRightCol QPushButton[variant="gameControl"][teamSelected="true"],
QWidget#TaggingRightCol QPushButton[variant="gameControl"][teamSelected="true"]:focus,
QWidget#TaggingRightCol QPushButton[variant="gameControl"][flash="true"],
QWidget#TaggingRightCol QPushButton[variant="gameControl"][flash="true"]:focus,
QWidget#TaggingRightCol QPushButton[variant="gameControl"][controlsHidden="true"],
QWidget#TaggingRightCol QPushButton[variant="gameControl"][controlsHidden="true"]:focus {
  padding: 4px 2px;
  min-height: 72px;
  border-radius: 6px;
}
QWidget#TaggingRightCol QPushButton[variant="gameControl"][size="sm"],
QWidget#TaggingRightCol QPushButton[variant="gameControl"][size="sm"]:focus {
  padding: 4px 2px;
  min-height: 32px;
  border-radius: 6px;
}
QWidget#TaggingRightCol QPushButton[variant="gameControlFollowUp"],
QWidget#TaggingRightCol QPushButton[variant="gameControlFollowUp"][size="md"],
QWidget#TaggingRightCol QPushButton[variant="gameControlFollowUp"]:focus,
QWidget#TaggingRightCol QPushButton[variant="gameControlFollowUp"][size="md"]:focus,
QWidget#TaggingRightCol QPushButton[variant="gameControlFollowUp"][flash="true"],
QWidget#TaggingRightCol QPushButton[variant="gameControlFollowUp"][flash="true"]:focus {
  padding: 4px 2px;
  font-size: 11px;
  min-height: 72px;
  border-radius: 6px;
}

QLabel[role="quarterTrackLabel"] {
  font-size: 10px;
  font-weight: 400;
}
QLabel[role="quarterTrackLabel"][quarterState="current"] {
  font-weight: 600;
}

/* =========================
   Progress Bar
========================= */

QProgressBar {
  border: none;
  border-radius: 4px;
  background: #e4e4e7;
  max-height: 8px;
  min-height: 8px;
  text-align: center;
  font-size: 0px;
}

QProgressBar::chunk {
  border-radius: 4px;
  background: #18181b;
}

QProgressDialog[role="blocking"] {
  min-width: 520px;
  min-height: 180px;
}

/* =========================
   ScrollBar
========================= */

QScrollBar:vertical {
  background: transparent;
  width: 6px;
  border: none;
  margin: 0;
}

QScrollBar::handle:vertical {
  background: #d4d4d8;
  border-radius: 4px;
  min-height: 24px;
}

QScrollBar::handle:vertical:hover {
  background: #a1a1aa;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
  height: 0;
  border: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
  background: transparent;
}

QScrollBar:horizontal {
  background: transparent;
  height: 6px;
  border: none;
  margin: 0;
}

QScrollBar::handle:horizontal {
  background: #d4d4d8;
  border-radius: 4px;
  min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
  background: #a1a1aa;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
  width: 0;
  border: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
  background: transparent;
}

/* =========================
   Splitter
========================= */

QSplitter::handle {
  background: #e4e4e7;
}

QSplitter::handle:hover {
  background: #d4d4d8;
}

QSplitter::handle:horizontal {
  width: 1px;
}

QSplitter::handle:vertical {
  height: 1px;
}

/* =========================
   Dialog
========================= */

QDialog {
  background: #FFFFFF;
  color: #09090b;
}

/* =========================
   ToolTip
========================= */

QToolTip {
  background: #18181b;
  color: #fafafa;
  border: none;
  border-radius: 6px;
  padding: 6px 10px;
  font-size: 13px;
}

/* =========================
   FormLayout label styling
========================= */

QFormLayout QLabel {
  color: #09090b;
  font-weight: 500;
  font-size: 14px;
}

/* =========================
   MessageBox
========================= */

QMessageBox {
  background: #FFFFFF;
}

QMessageBox QLabel {
  color: #09090b;
  font-size: 14px;
}

QMessageBox QPushButton {
  min-width: 80px;
}

/* =========================
   Game setup – language corner, optional fields, color picker
========================= */

QComboBox#GameSetupLanguageCombo {
  color: #71717a;
  background: transparent;
  border: 1px solid transparent;
  min-height: 28px;
  padding: 2px 8px;
  font-size: 12px;
}

QComboBox#GameSetupLanguageCombo:hover {
  border: 1px solid #e4e4e7;
  background: #fafafa;
  color: #09090b;
}

QComboBox#GameSetupLanguageCombo:focus {
  border: 1px solid #d4d4d8;
}

QFrame#TeamColorPopup {
  background: #FFFFFF;
  border: 1px solid #e4e4e7;
  border-radius: 8px;
}

QLineEdit#TeamColorHexEdit {
  font-size: 12px;
  padding: 6px 10px;
  min-height: 28px;
}

/* Hidden tagging keys stay in the QWERTY holes. The dashed stroke is the cue
   that a click will not tag. Right-click still opens Show. */
QPushButton[variant="gameControl"][controlsHidden="true"] {
  border: 1px dashed #a1a1aa;
  background: #fafafa;
  color: #71717a;
}
QPushButton[variant="gameControl"][controlsHidden="true"] QLabel[role="gameControlTitle"],
QPushButton[variant="gameControl"][controlsHidden="true"] QLabel[role="muted"] {
  color: #71717a;
}

QDialog[role="controlsEditor"] {
  background: #fafafa;
}

QDialog#ControlsSharedPaths {
  background: #fafafa;
}

QListWidget#ControlsSharedList {
  background: #ffffff;
  border: 1px solid #e4e4e7;
  border-radius: 6px;
  padding: 4px;
}

QListWidget#ControlsSharedList::item {
  padding: 4px 2px;
}

QLabel#ControlsSharedEmpty {
  color: #71717a;
}

QWidget#ControlsEditorGridScroll {
  max-width: 500px;
}

QWidget#ControlsEditorGrid QPushButton[variant="gameControl"],
QWidget#ControlsEditorGrid QPushButton[variant="gameControl"][size="md"],
QWidget#ControlsEditorGrid QPushButton[variant="gameControl"]:focus,
QWidget#ControlsEditorGrid QPushButton[variant="gameControl"][size="md"]:focus,
QWidget#ControlsEditorGrid QPushButton[variant="gameControl"][activeMain="true"],
QWidget#ControlsEditorGrid QPushButton[variant="gameControl"][activeMain="true"]:focus,
QWidget#ControlsEditorGrid QPushButton[variant="gameControl"][controlsHidden="true"],
QWidget#ControlsEditorGrid QPushButton[variant="gameControl"][controlsHidden="true"]:focus {
  padding: 4px 2px;
  min-height: 52px;
  border-radius: 6px;
}

QLabel[role="inlineError"] {
  color: #b91c1c;
  min-height: 18px;
}

QWidget[role="breakUiToggle"] {
  background: #f4f4f5;
  border: 1px solid #e4e4e7;
  border-radius: 8px;
}
QPushButton[role="breakUiSegment"] {
  background: transparent;
  border: none;
  color: #52525b;
  padding: 4px 10px;
  min-height: 28px;
  font-weight: 400;
}
QPushButton[role="breakUiSegment"]:checked {
  background: #ffffff;
  color: #09090b;
  border: 1px solid #e4e4e7;
  border-radius: 6px;
}
